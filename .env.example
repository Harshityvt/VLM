# Copy to .env and fill in. Never commit .env.

# NGC key: lets the NIM containers download model weights from NGC (ngc.nvidia.com -> Setup -> API Key)
NGC_API_KEY=

# build.nvidia.com key: hosted Graphic Elements + answer / judge / query LLMs
NVIDIA_API_KEY=

# OpenRouter key for GLM-4.6V in the OCR box: https://openrouter.ai/keys (needs a few dollars of credit)
OPENROUTER_API_KEY=

# Optional: Hugging Face token for the DeepSeek-OCR weight download (public model; raises rate limits)
HF_TOKEN=
